# sittter — environment variables
#
# Grouped by the phase that introduces them, per docs/dev-plan.md §4.
# Copy to .env and fill in. .env is gitignored and never committed.
#
# USE .env, NOT .env.local. Next.js loads .env.local AFTER .env and lets it
# win, so a variable left empty there silently overrides a real value here —
# and the failure surfaces far away, as "RESEND_API_KEY is required" on a
# page whose .env has it set. If a .env.local exists and you did not put it
# there on purpose, delete it.

# ─────────────────────────────────────────────────────────────────────
# ALL PHASES
# ─────────────────────────────────────────────────────────────────────

# development | production | test
NODE_ENV=development

# Fixed to America/New_York. Present so the zone is never hard-coded in
# logic. Calendar dates in src/core/ are 'YYYY-MM-DD' strings in this zone.
APP_TIMEZONE=America/New_York

# ─────────────────────────────────────────────────────────────────────
# PHASE 1 — persistence and admin authentication
# ─────────────────────────────────────────────────────────────────────

# Neon Postgres connection string.
DATABASE_URL=

# HMAC key for session cookie signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Absolute base URL, used to build links in emails. No trailing slash.
APP_URL=http://localhost:3000

# Email delivery. First used for magic links, so it is needed from Phase 1.
RESEND_API_KEY=

# Verified sender address on the custom domain. Until a domain is verified,
# Resend's onboarding@resend.dev only delivers to the API key owner.
EMAIL_FROM=

# ─────────────────────────────────────────────────────────────────────
# PHASE 3 — links
# ─────────────────────────────────────────────────────────────────────

# Slug resolution attempts per IP per minute.
LINK_RATE_LIMIT_PER_MINUTE=30

# ─────────────────────────────────────────────────────────────────────
# PHASE 4 — photos
# ─────────────────────────────────────────────────────────────────────

# Vercel Blob access. Provisioned by Vercel.
BLOB_READ_WRITE_TOKEN=

# Lifetime of a signed photo URL, in seconds.
PHOTO_SIGNED_URL_TTL_SECONDS=900

# ─────────────────────────────────────────────────────────────────────
# PHASE 5 — calendar
# ─────────────────────────────────────────────────────────────────────

# Service account identity.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# PEM key with newlines escaped. Wrap in double quotes and keep the \n
# sequences literal — a key pasted across real line breaks fails as
# "error:1E08010C:DECODER routines::unsupported", which names nothing
# that leads back to the cause.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Written after the calendar is created, or stored in the businesses table.
GOOGLE_CALENDAR_ID=

# ─────────────────────────────────────────────────────────────────────
# PHASE 6 — notifications
# ─────────────────────────────────────────────────────────────────────

# Provisioned by Vercel. Verified as a bearer token in the cron route.
CRON_SECRET=

# Local hour the digest should send.
DIGEST_LOCAL_HOUR=7
